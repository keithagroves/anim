{
  "name": "anim",
  "version": "0.1.0",
  "description": "Narrated explainer videos from JSON scene files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithagroves/anim.git"
  },
  "private": true,
  "type": "module",
  "bin": {
    "anim": "bin/anim.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "video-types",
    "vo/*.py",
    "vo/pyproject.toml",
    "vo/uv.lock",
    "vo/ref/af_heart.wav"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "anim": "tsx src/cli/anim.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
