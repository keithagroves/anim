    { "id": "lit", "target": "cell", "preset": "to", "with": "glow", "dur": 0.3, "to": { "fill": "cell" } },
    { "target": "cell", "preset": "to", "after": "lit", "gap": 0.35, "dur": 0.35, "ease": "inOut", "to": { "fill": "cellDim" } },

