    "s6.c3": { "type": "chip", "text": "not yet understood 2–4%", "to": "s6.seg3.bottom", "at": { "below": "s6.c7", "gap": "sm", "align": "right", "dx": 180 } },

    "s6.scale": { "type": "rect", "w": 700, "h": 76, "radius": "md", "fill": "card", "stroke": "line", "strokeWidth": "thin", "text": "holds up to trillions of parameters", "style": "body", "labelColor": "text", "at": { "region": "right-half", "align": "bottom-left", "dx": 80, "dy": -130 } }
