    "s6.oldFill": { "type": "rect", "w": 12, "h": 52, "radius": 4, "fill": "old", "layer": 1, "at": { "in": "s6.track", "align": "left" } },
    "s6.v1": { "type": "text", "text": "~1.7% interpretable", "style": "label", "fill": "old", "anchor": "start", "layer": 1, "at": { "rightOf": "s6.oldFill", "gap": "sm" } },

    "s6.l2": { "type": "text", "text": "now · Qwen3-32B (early audit)", "style": "body", "fill": "text", "anchor": "start", "at": { "below": "s6.track", "gap": "lg", "align": "left" } },
