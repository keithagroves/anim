  "timeline": [
    { "id": "ask", "target": "s2.ask", "preset": "words-in", "at": 0.15 },

    { "id": "chips", "target": ["s2.c1", "s2.c2", "s2.c3"], "preset": "pop", "at": 3.16, "stagger": 0.64, "overshoot": 1.5, "dur": 0.45 },
    { "target": ["s2.v1", "s2.v2", "s2.v3"], "preset": "draw-on", "with": "chips", "offset": 0.1, "stagger": 0.64, "dur": 0.4 },

