    "s2.r2": { "type": "group", "children": ["s2.v2", "s2.c2"], "layout": { "dir": "row", "gap": "sm", "align": "center" } },
    "s2.r3": { "type": "group", "children": ["s2.v3", "s2.c3"], "layout": { "dir": "row", "gap": "sm", "align": "center" } },
