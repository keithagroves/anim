    { "id": "oh", "target": "s2.ring", "preset": "scale-in", "at": "cue:oh", "dur": 0.5 },
    { "target": "s2.minus", "preset": "pop", "with": "oh", "offset": 0.3, "overshoot": 1.5, "dur": 0.4 },
    { "target": "s2.roundCap", "preset": "words-in", "with": "oh", "offset": 0.25 },

    { "preset": "clear", "at": "end-0.6" }
