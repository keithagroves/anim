{
  "id": "s3",
  "objects": {
    "s3.title": { "type": "text", "text": "two filters", "style": "h2", "anchor": "start",
      "at": { "region": "right-two-thirds", "align": "top-left" } },

    "s3.stk1": { "type": "rect", "w": 130, "h": 52, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 1,
      "at": { "region": "right-two-thirds", "align": "left", "dx": 40, "dy": 16 } },
    "s3.stk2": { "type": "rect", "w": 130, "h": 52, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 2,
      "at": { "region": "right-two-thirds", "align": "left", "dx": 32, "dy": 8 } },
    "s3.stk3": { "type": "rect", "w": 130, "h": 52, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 3,
      "text": "200", "style": "label", "labelColor": "task",
      "at": { "region": "right-two-thirds", "align": "left", "dx": 24, "dy": 0 } },
    "s3.stackCap": { "type": "text", "text": "candidate tasks", "style": "small",
      "at": { "below": "s3.stk1", "gap": "sm", "dx": -8 } },

    "s3.gate1": { "type": "rect", "w": 28, "h": 400, "radius": 14, "fill": "card", "stroke": "judge", "strokeWidth": "md", "layer": 1,
      "at": { "region": "right-two-thirds", "align": "center", "dx": -188 } },
    "s3.gate2": { "type": "rect", "w": 28, "h": 400, "radius": 14, "fill": "card", "stroke": "checker", "strokeWidth": "md", "layer": 1,
      "at": { "region": "right-two-thirds", "align": "center", "dx": 192 } },
    "s3.g1Label": { "type": "text", "text": "needs deep research?", "style": "label", "fill": "judge",
      "at": { "above": "s3.gate1", "gap": "sm" } },
    "s3.g2Label": { "type": "text", "text": "solvable without web?", "style": "label", "fill": "checker",
      "at": { "above": "s3.gate2", "gap": "sm" } },
    "s3.confCap": { "type": "text", "text": "confidence > 0.7", "style": "small", "fill": "judge",
      "at": { "below": "s3.gate1", "gap": "sm" } },

    "s3.c1": { "type": "rect", "w": 80, "h": 34, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 4,
      "at": { "region": "right-two-thirds", "align": "center", "dx": 0, "dy": -145 } },
    "s3.c2": { "type": "rect", "w": 80, "h": 34, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 4,
      "at": { "region": "right-two-thirds", "align": "center", "dx": -272, "dy": -87 } },
    "s3.c3": { "type": "rect", "w": 80, "h": 34, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 4,
      "at": { "region": "right-two-thirds", "align": "center", "dx": 0, "dy": -29 } },
    "s3.c4": { "type": "rect", "w": 80, "h": 34, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 4,
      "at": { "region": "right-two-thirds", "align": "center", "dx": 0, "dy": 29 } },
    "s3.c5": { "type": "rect", "w": 80, "h": 34, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 4,
      "at": { "region": "right-two-thirds", "align": "center", "dx": -272, "dy": 87 } },
    "s3.c6": { "type": "rect", "w": 80, "h": 34, "radius": "sm", "fill": "card", "stroke": "task", "strokeWidth": "md", "layer": 4,
      "at": { "region": "right-two-thirds", "align": "center", "dx": 0, "dy": 145 } },

    "s3.x2a": { "type": "line", "from": "s3.c2.top:0.35", "to": "s3.c2.bottom:0.65", "stroke": "bad", "strokeWidth": "md", "layer": 5 },
    "s3.x2b": { "type": "line", "from": "s3.c2.top:0.65", "to": "s3.c2.bottom:0.35", "stroke": "bad", "strokeWidth": "md", "layer": 5 },
    "s3.x5a": { "type": "line", "from": "s3.c5.top:0.35", "to": "s3.c5.bottom:0.65", "stroke": "bad", "strokeWidth": "md", "layer": 5 },
    "s3.x5b": { "type": "line", "from": "s3.c5.top:0.65", "to": "s3.c5.bottom:0.35", "stroke": "bad", "strokeWidth": "md", "layer": 5 },

    "s3.model": { "type": "rect", "w": 320, "h": 150, "radius": "md", "fill": "card", "stroke": "checker", "strokeWidth": "md", "shadow": true, "layer": 2,
      "at": { "rightOf": "s3.gate2", "gap": 40, "align": "top" } },
    "s3.globe": { "type": "circle", "r": 18, "fill": "none", "stroke": "muted", "strokeWidth": "thin", "layer": 3,
      "at": { "in": "s3.model", "align": "top-left", "pad": "md" } },
    "s3.equator": { "type": "line", "from": "s3.globe.left", "to": "s3.globe.right", "stroke": "muted", "strokeWidth": "thin", "layer": 3 },
    "s3.noweb": { "type": "line", "from": "s3.globe.top:0", "to": "s3.globe.bottom:1", "stroke": "bad", "strokeWidth": "md", "layer": 3 },
    "s3.modelText": { "type": "text", "text": "model · no web", "style": "label", "anchor": "start", "layer": 3,
      "at": { "rightOf": "s3.globe", "gap": "sm" } },
    "s3.cutCap": { "type": "text", "text": "did well anyway → cut", "style": "small", "fill": "bad",
      "at": { "below": "s3.model", "gap": "xs" } },

    "s3.stat": { "type": "text", "text": "{value}", "value": 0, "decimals": 0, "style": "stat", "fill": "task",
      "at": { "below": "s3.model", "gap": "md" } },
    "s3.statCap": { "type": "text", "text": "tasks survive", "style": "caption", "fill": "task",
      "at": { "below": "s3.stat", "gap": "xs" } },
    "s3.usedCap": { "type": "text", "text": "100 used in the benchmark", "style": "small",
      "at": { "below": "s3.statCap", "gap": "xs" } }
  },
  "timeline": [
    { "id": "title", "target": "s3.title", "preset": "rise-in", "at": 0.2 },
    { "target": ["s3.stk1", "s3.stk2", "s3.stk3"], "preset": "rise-in", "at": 0.5, "stagger": 0.08, "distance": 24 },
    { "target": "s3.stackCap", "preset": "fade-in", "at": 0.9 },
    { "target": "s3.gate1", "preset": "draw-on", "at": 0.9, "dur": 0.7 },
    { "target": "s3.g1Label", "preset": "fade-in", "at": 1.2 },
    { "target": "s3.gate2", "preset": "draw-on", "at": 1.5, "dur": 0.7 },
    { "target": "s3.g2Label", "preset": "fade-in", "at": 1.8 },

    { "id": "flow", "target": ["s3.c1", "s3.c2", "s3.c3", "s3.c4", "s3.c5", "s3.c6"], "preset": "fly-from", "from": "s3.stk3",
      "at": "cue:qualify", "stagger": 0.12, "dur": 0.8, "ease": "inOut" },
    { "id": "rej", "target": ["s3.c2", "s3.c5"], "preset": "to", "to": { "stroke": "bad" }, "at": "cue:qualify", "offset": 1.55, "dur": "fast" },
    { "target": ["s3.x2a", "s3.x2b", "s3.x5a", "s3.x5b"], "preset": "draw-on", "with": "rej", "stagger": 0.08, "dur": 0.3 },
    { "target": "s3.confCap", "preset": "rise-in", "with": "rej", "offset": 0.2, "distance": 16 },
    { "target": ["s3.c2", "s3.x2a", "s3.x2b", "s3.c5", "s3.x5a", "s3.x5b"], "preset": "sink-out", "at": "cue:qualify", "offset": 2.6, "dur": 0.6 },
    { "target": ["s3.c1", "s3.c3", "s3.c4", "s3.c6"], "preset": "pulse", "at": "cue:qualify", "offset": 3.4, "stagger": 0.08, "amount": 0.1 },

    { "id": "model", "target": "s3.model", "preset": "pop", "at": "cue:nosearch", "dur": 0.5 },
    { "target": ["s3.globe", "s3.equator", "s3.modelText"], "preset": "fade-in", "with": "model", "offset": 0.2, "dur": "fast" },
    { "target": "s3.noweb", "preset": "draw-on", "with": "model", "offset": 0.45, "dur": 0.3 },
    { "id": "into", "target": "s3.c3", "preset": "to", "to": { "at": { "in": "s3.model", "align": "bottom", "pad": "sm" } }, "at": "cue:nosearch", "offset": 0.7, "dur": 0.8, "ease": "inOut" },
    { "target": "s3.cutCap", "preset": "rise-in", "at": "cue:cut", "offset": -1.3, "distance": 12, "dur": "fast" },

    { "id": "cut", "target": "s3.c3", "preset": "to", "to": { "fill": "bad", "stroke": "bad" }, "at": "cue:cut", "dur": 0.25 },
    { "target": "s3.c3", "preset": "sink-out", "after": "cut", "gap": 0.05, "dur": 0.35 },
    { "target": ["s3.model", "s3.globe", "s3.equator", "s3.noweb", "s3.modelText", "s3.cutCap"], "preset": "fade-out", "at": "cue:cut", "offset": 0.4, "dur": 0.35 },

    { "id": "kept", "target": "s3.stat", "preset": "rise-in", "at": "cue:kept", "dur": "fast", "distance": 20 },
    { "target": "s3.stat", "preset": "count-up", "at": "cue:kept", "dur": 0.85, "ease": "out", "to": { "value": 155 } },
    { "target": ["s3.c1", "s3.c4", "s3.c6"], "preset": "to", "to": { "at": { "in": "s3.stat" }, "opacity": 0, "scale": 0.6 }, "at": "cue:kept", "stagger": 0.08, "dur": 0.6, "ease": "in" },
    { "target": "s3.statCap", "preset": "fade-in", "at": "cue:kept", "offset": 0.3, "dur": "fast" },
    { "target": "task", "preset": "pulse", "at": "cue:kept", "offset": 0.9, "amount": 0.06 },
    { "target": "s3.usedCap", "preset": "fade-in", "at": "cue:kept", "offset": 0.5, "dur": "fast" },

    { "target": ["s3.title", "s3.stk1", "s3.stk2", "s3.stk3", "s3.stackCap", "s3.gate1", "s3.gate2", "s3.g1Label", "s3.g2Label", "s3.confCap", "s3.stat", "s3.statCap", "s3.usedCap"],
      "preset": "fade-out", "at": 13.42, "dur": 0.35 }
  ]
}
