    {
      "id": "s1",
      "target": [
        0,
        8.95
      ],
      "brief": "Hook: chatbots (ChatGPT, Claude, Gemini pills) all run on one box, the transformer; its job: guess the next word ('the cat sat on the ___' → mat)."
    },
    {
      "id": "s2",
      "target": [
        8.95,
        19.3
      ],
      "brief": "Words become numbers: the sentence splits into seven chips (cue:tokens), each gets a pink number strip (cue:numbers), and a small meaning map shows similar words close together (cue:similar)."
    },
    {
      "id": "s3",
      "target": [
        19.3,
        30.9
      ],
      "brief": "Attention: faint arcs between all words (cue:attention); 'it' sends arcs to every word, thickest to 'cat' (cue:it, cue:cat)."
    },
    {
      "id": "s4",
      "target": [
        30.9,
        39.8
      ],
      "brief": "Old vs new: a grey reader steps one word at a time while earlier words fade (cue:old); then every chip lights at once (cue:all)."
    },
    {
      "id": "s5",
      "target": [
        39.8,
        47.6
      ],
      "brief": "Layers: blue bands stack above the sentence (cue:stack); the low band notes grammar (cue:grammar), the high band meaning (cue:meaning). Chips leave at the end."
    },
    {
      "id": "s6",
      "target": [
        47.6,
        59.6
      ],
      "brief": "Prediction: the sentence with 'so it ___'; bars score next words (cue:next); 'slept' wins and joins the sentence (cue:append); more words follow (cue:end)."
    }
  ]
