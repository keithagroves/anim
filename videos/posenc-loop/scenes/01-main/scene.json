{
  "id": "01-main",
  "objects": {
    "title": {
      "type": "text",
      "text": "Positional encoding",
      "style": "h3",
      "anchor": "start",
      "at": {
        "region": "top-left",
        "align": "top-left"
      }
    },
    "src": {
      "type": "text",
      "text": "“Attention Is All You Need” · Vaswani et al., 2017 · section 3.5",
      "style": "small",
      "anchor": "start",
      "at": {
        "below": "title",
        "gap": "xs",
        "align": "left"
      }
    },
    "cap1": {
      "type": "text",
      "text": "1  attention alone ignores order",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap2": {
      "type": "text",
      "text": "2  so add a position signal:\n    waves of different speeds",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap3": {
      "type": "text",
      "text": "3  input = word + position",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap4": {
      "type": "text",
      "text": "4  now order changes the result",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "caps": {
      "type": "group",
      "children": [
        "cap1",
        "cap2",
        "cap3",
        "cap4"
      ],
      "layout": {
        "dir": "col",
        "gap": "sm",
        "align": "start"
      },
      "at": {
        "region": "left-third",
        "align": "left"
      }
    },
    "formula": {
      "type": "text",
      "text": "PE(pos, 2i)   = sin(pos / 10000^(2i/d))\nPE(pos, 2i+1) = cos(pos / 10000^(2i/d))",
      "style": "mono",
      "size": 21,
      "fill": "text",
      "anchor": "start",
      "at": {
        "below": "caps",
        "gap": "lg",
        "align": "left"
      }
    },
    "credit": {
      "type": "text",
      "text": "example sentence · vectors and wave speeds are illustrative (the paper uses 512 dims)",
      "style": "small",
      "anchor": "start",
      "at": {
        "region": "bottom-left",
        "align": "bottom-left"
      }
    },
