  "sections": [
    {
      "id": "s1",
      "target": [
        0,
        15
      ],
      "brief": "15 s loop of positional encoding: swapping two words only reorders attention's outputs; sine waves give each slot a pattern that is added to the word; swapping back now changes the outputs; resets so the last frame is the first."
    }
  ]
