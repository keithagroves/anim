    "title": {
      "type": "text",
      "text": "Multi-head attention",
      "style": "h3",
      "anchor": "start",
      "at": {
        "region": "top-left",
        "align": "top-left"
      }
    },
    "src": {
      "type": "text",
      "text": "“Attention Is All You Need” · Vaswani et al., 2017 · 8 heads in parallel",
      "style": "small",
      "anchor": "start",
      "at": {
        "below": "title",
        "gap": "xs",
        "align": "left"
      }
    },
    "cap1": {
      "type": "text",
      "text": "1  eight heads, each with its own\n    learned Wq, Wk, Wv",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap2": {
      "type": "text",
      "text": "2  head 1: each word → the one before",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap3": {
      "type": "text",
      "text": "3  head 2: “it” → “cat”",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap4": {
      "type": "text",
      "text": "4  head 3: verb → its subject",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap5": {
      "type": "text",
      "text": "5  join all 8, mix them with Wᴼ",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "caps": {
      "type": "group",
      "children": [
        "cap1",
        "cap2",
        "cap3",
        "cap4",
        "cap5"
      ],
      "layout": {
        "dir": "col",
        "gap": "sm",
        "align": "start"
      },
      "at": {
        "region": "left-third",
        "align": "left"
      }
    },
    "formula": {
      "type": "text",
      "text": "MultiHead(Q, K, V) =\n  Concat(head₁ … head₈) Wᴼ\n\n8 heads × dₖ 64 = 512",
      "style": "mono",
      "size": 26,
      "fill": "text",
      "anchor": "start",
      "at": {
        "below": "caps",
        "gap": "lg",
        "align": "left"
      }
    },
