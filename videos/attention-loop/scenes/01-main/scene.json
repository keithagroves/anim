{
  "id": "01-main",
  "objects": {
    "title": {
      "type": "text",
      "text": "Attention",
      "style": "h3",
      "anchor": "start",
      "at": {
        "region": "top-left",
        "align": "top-left"
      }
    },
    "src": {
      "type": "text",
      "text": "“Attention Is All You Need” · Vaswani et al., 2017 · scaled dot-product attention",
      "style": "small",
      "anchor": "start",
      "at": {
        "below": "title",
        "gap": "xs",
        "align": "left"
      }
    },
    "cap1": {
      "type": "text",
      "text": "1  each word: a query, key and value",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap2": {
      "type": "text",
      "text": "2  query scored against every key",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap3": {
      "type": "text",
      "text": "3  softmax turns scores into weights",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap4": {
      "type": "text",
      "text": "4  output = weighted sum of values",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "cap5": {
      "type": "text",
      "text": "5  every word does this at once",
      "style": "body",
      "fill": "muted",
      "anchor": "start"
    },
    "caps": {
      "type": "group",
      "children": [
        "cap1",
        "cap2",
        "cap3",
        "cap4",
        "cap5"
      ],
      "layout": {
        "dir": "col",
        "gap": "sm",
        "align": "start"
      },
      "at": {
        "region": "left-third",
        "align": "left"
      }
    },
    "formula": {
      "type": "text",
      "text": "Attention(Q, K, V) = softmax(QKᵀ / √dₖ) V",
      "style": "mono",
      "fill": "text",
